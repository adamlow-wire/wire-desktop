{
  "all": true,
  "clean": false,
  "exclude": ["**/*.d.ts", "**/*.d.mts", "**/*.test*.ts", "**/wrap/**"],
  "extension": [".ts", ".mts"],
  "include": ["electron/src/**/*.ts", "electron/src/**/*.mts"],
  "per-file": false,
  "report-dir": "coverage/electron",
  "reporter": ["html", "json", "text-summary"],
  "require": ["./.babel-register.js"],
  "temp-dir": ".nyc_output"
}
